#header {
background-image: url("https://i.postimg.cc/2yRmpjNc/aven-water-night-head.png") !important;
background-repeat: no-repeat !important;
background-size: cover !important;
background-position: 20% 20% !important;
position: relative;
z-index: 10;
border: none !important;
}

#header ul.primary,
#header .primary,
#header .menu,
#header ul.user.navigation,
#header .user.navigation {
background-color: rgba(100, 100, 190, 0.85) !important;
background-image: none !important;
box-shadow: none !important;
border: none !important;
}

#header .logo,
#header h1 sup {
display: none !important;
}

#header h1 {
display: flex;
justify-content: flex-end;
align-items: center;
height: 15em;
margin: 0;
width: 100%;
padding-right: 5%;
box-sizing: border-box;
}

#header h1 a {
text-decoration: none !important;
}

#header h1 a span {
display: none !important;
}

#header h1::before {
content: "🎲 ";
font-size: 45px !important;
filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.8));
margin-right: 15px;
}

#header h1 a::before {
content: "Aventurine of Our Own";
display: inline-block;
font-size: 55px !important;
line-height: 1.2 !important;
letter-spacing: normal !important;
white-space: nowrap;
font-family: 'Snell Roundhand', 'Monotype Corsiva', 'Brush Script MT', 'Lucida Handwriting', 'Apple Chancery', cursive !important;
font-weight: normal !important;
background: linear-gradient(to top, #c8fafa, #fafac8);
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
color: transparent !important;
filter: drop-shadow(-1px -1px 0 #1a2052)
drop-shadow(1px -1px 0 #1a2052)
drop-shadow(-1px 1px 0 #1a2052)
drop-shadow(1px 1px 0 #1a2052)
drop-shadow(3px 3px 0 rgba(12, 16, 51, 0.8))
drop-shadow(4px 4px 0 rgba(12, 16, 51, 0.8))
drop-shadow(6px 6px 5px rgba(0, 0, 0, 0.6)) !important;
}

#header h1::after {
content: " 🌊";
font-size: 45px !important;
filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.8));
margin-left: 15px;
}

body {
background: transparent !important;
position: relative;
}

body::before {
content: "";
position: fixed;
top: 0;
left: 0;
right: 0;
bottom: 0;
z-index: -1;
background-color: #241ebd !important;
background-image: url("https://www.transparenttextures.com/patterns/concrete-wall-2.png") !important;
background-repeat: repeat !important;
}

#outer.wrapper {
background: transparent !important;
box-shadow: none !important;
}

